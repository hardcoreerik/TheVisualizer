//! format: 2
//! id: thevisualizer.spectrum-skyline
//! name: Spectrum Skyline
//! version: 0.1.0
//! author: TheVisualizer
//! license: Apache-2.0
//! parameter: Audio|response|Response|0.4|5.0|1.8
//! parameter: City|buildings|Building Count|16.0|64.0|42.0
//! parameter: City|height|Tower Height|0.2|1.5|0.85
//! parameter: City|window-density|Window Density|2.0|14.0|7.0
//! parameter: Surface|reflection|Reflection|0.0|1.5|0.65
//! parameter: Surface|haze|Horizon Haze|0.0|2.0|0.8
//! parameter: Motion|traffic|Light Traffic|-3.0|3.0|0.6
//! parameter: Color|phase|Gradient Phase|-1.0|1.0|0.0
//! parameter: Surface|edge-glow|Edge Glow|0.0|3.0|1.3
//! parameter: Surface|exposure|Exposure|0.2|3.0|1.1
//! ---
struct PresetUniforms { resolution: vec2f, time: f32, gain: f32, audio: vec4f }
@group(0) @binding(0) var<uniform> uniforms: PresetUniforms;
struct AudioFeatures { waveform: array<f32, 256>, spectrum: array<f32, 64> }
@group(0) @binding(1) var<storage, read> features: AudioFeatures;
struct FrameExtras { delta: f32, peak: f32, waveform_len: f32, spectrum_len: f32, onset: f32, transient: f32 }
@group(0) @binding(2) var<uniform> extras: FrameExtras;
struct SceneState { values: array<f32, 96> }
@group(0) @binding(3) var<storage, read> scene: SceneState;
struct ModeParameters { values: array<f32, 40> }
@group(0) @binding(4) var<storage, read> controls: ModeParameters;
@vertex fn vs_main(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
    let v = array(vec2f(-1.0, -3.0), vec2f(3.0, 1.0), vec2f(-1.0, 1.0));
    return vec4f(v[i], 0.0, 1.0);
}
fn routed(o: u32) -> vec3f { return vec3f(scene.values[o], scene.values[o + 1u], scene.values[o + 2u]); }
fn hash21(p: vec2f) -> f32 { return fract(sin(dot(p, vec2f(127.1, 311.7))) * 43758.5453); }
fn glow(d: f32, w: f32) -> f32 { return exp(-d * d / max(w * w, 0.000001)); }
@fragment fn fs_main(@builtin(position) p: vec4f) -> @location(0) vec4f {
    let res = max(uniforms.resolution, vec2f(1.0));
    let uv = p.xy / res;
    let count = controls.values[1];
    let cell = floor(uv.x * count);
    let local = fract(uv.x * count);
    let source = min(u32(cell / count * 64.0), 63u);
    let energy = clamp(features.spectrum[source] * controls.values[0] * uniforms.gain, 0.0, 1.4);
    let horizon = 0.61;
    let height = (0.06 + energy * controls.values[2] * 0.52) * (0.7 + hash21(vec2f(cell, 4.0)) * 0.3);
    let top = horizon - height;
    let building = step(top, uv.y) * step(uv.y, horizon) * step(0.08, local) * step(local, 0.92);
    let rows = controls.values[3];
    let windows = building * step(0.48, fract((uv.y - top) * rows / max(height, 0.01)))
        * step(0.38, fract(local * 5.0 + cell));
    let edge = glow(abs(uv.y - top), 0.0025) * step(0.05, local) * step(local, 0.95);
    let reflected_y = horizon + (horizon - top) * controls.values[4];
    let reflection = step(horizon, uv.y) * step(uv.y, reflected_y)
        * step(0.14, local) * step(local, 0.86)
        * (1.0 - (uv.y - horizon) / max(reflected_y - horizon, 0.01)) * 0.45;
    let traffic = glow(abs(uv.y - 0.78), 0.004) * pow(max(0.0, sin(uv.x * 95.0 - uniforms.time * controls.values[6] * 6.0)), 20.0);
    let haze = exp(-abs(uv.y - horizon) * 45.0) * controls.values[5];
    let phase = fract(cell / count + controls.values[7] * 0.25);
    let tower_color = mix(routed(76u), routed(84u), phase);
    var color = routed(88u) * (0.12 + 0.15 * (1.0 - uv.y));
    color += tower_color * building * (0.08 + energy * 0.18);
    color += mix(routed(80u), routed(84u), phase) * (windows + edge * controls.values[8]);
    color += routed(76u) * reflection * (0.2 + energy) + routed(72u) * traffic * (0.4 + extras.onset);
    color += mix(routed(76u), routed(80u), uv.x) * haze * 0.12;
    color = 1.0 - exp(-max(color, vec3f(0.0)) * controls.values[9]);
    return vec4f(color, 1.0);
}
