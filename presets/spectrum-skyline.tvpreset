//! format: 2
//! id: thevisualizer.spectrum-skyline
//! name: Spectrum Skyline
//! version: 0.2.0
//! author: TheVisualizer
//! license: Apache-2.0
//! parameter: Audio|response|Response|0.4|5.0|1.9
//! parameter: Bars|count|Bar Count|24.0|96.0|56.0
//! parameter: Bars|height|Bar Height|0.3|1.8|1.05
//! parameter: Bars|segments|LED Segments|8.0|40.0|22.0
//! parameter: Bars|gap|Bar Gap|0.05|0.45|0.18
//! parameter: Surface|reflection|Reflection|0.0|1.5|0.85
//! parameter: Surface|particles|Starfield|0.0|2.0|0.9
//! parameter: Color|blend|Blue-Magenta Blend|0.0|1.0|0.55
//! parameter: Surface|floor-glow|Floor Glow|0.0|2.0|0.7
//! parameter: Surface|exposure|Exposure|0.3|3.0|1.25
//! parameter: Motion|pulse|Beat Pulse|0.0|2.0|0.85
//! parameter: Bars|softness|Segment Softness|0.0|1.0|0.35
//! ---
struct PresetUniforms { resolution: vec2f, time: f32, gain: f32, audio: vec4f }
@group(0) @binding(0) var<uniform> uniforms: PresetUniforms;
struct AudioFeatures { waveform: array<f32, 256>, spectrum: array<f32, 64> }
@group(0) @binding(1) var<storage, read> features: AudioFeatures;
struct FrameExtras { delta: f32, peak: f32, waveform_len: f32, spectrum_len: f32, onset: f32, transient: f32, history_rows: f32, history_bands: f32 }
@group(0) @binding(2) var<uniform> extras: FrameExtras;
struct SceneState { values: array<f32, 96> }
@group(0) @binding(3) var<storage, read> scene: SceneState;
struct ModeParameters { values: array<f32, 40> }
@group(0) @binding(4) var<storage, read> controls: ModeParameters;

@vertex fn vs_main(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
    let v = array(vec2f(-1.0, -3.0), vec2f(3.0, 1.0), vec2f(-1.0, 1.0));
    return vec4f(v[i], 0.0, 1.0);
}

fn hash21(p: vec2f) -> f32 { return fract(sin(dot(p, vec2f(127.1, 311.7))) * 43758.5453); }
fn glow(d: f32, w: f32) -> f32 { return exp(-d * d / max(w * w, 1e-6)); }
fn hsv(h: f32, s: f32, v: f32) -> vec3f {
    let k = vec3f(1.0, 2.0 / 3.0, 1.0 / 3.0);
    let p = abs(fract(vec3f(h) + k) * 6.0 - 3.0);
    return v * mix(vec3f(1.0), clamp(p - 1.0, vec3f(0.0), vec3f(1.0)), s);
}
fn tonemap(c: vec3f, e: f32) -> vec3f { return 1.0 - exp(-max(c, vec3f(0.0)) * e); }
fn band(i: u32) -> f32 {
    return clamp(features.spectrum[min(i, 63u)] * uniforms.gain * controls.values[0], 0.0, 1.8);
}
fn wave_at(x: f32) -> f32 {
    let i = min(u32(clamp(x, 0.0, 0.999) * 256.0), 255u);
    return features.waveform[i];
}

@fragment fn fs_main(@builtin(position) p: vec4f) -> @location(0) vec4f {
    let res = max(uniforms.resolution, vec2f(1.0));
    let uv = p.xy / res;
    let count = controls.values[1];
    let cell = floor(uv.x * count);
    let local = fract(uv.x * count);
    let gap = controls.values[4];
    let in_bar = step(gap * 0.5, local) * step(local, 1.0 - gap * 0.5);
    let src = min(u32((cell + 0.5) / count * 64.0), 63u);
    let energy = band(src) * (1.0 + extras.onset * controls.values[10] * 0.35);
    let horizon = 0.58;
    let h = (0.04 + energy * controls.values[2] * 0.48) * (0.75 + hash21(vec2f(cell, 2.0)) * 0.35);
    let top = horizon - h;
    let building = in_bar * step(top, uv.y) * step(uv.y, horizon);
    // LED segment rows
    let segs = controls.values[3];
    let seg_uv = (horizon - uv.y) / max(h, 0.001) * segs;
    let seg_id = floor(seg_uv);
    let seg_f = fract(seg_uv);
    let led = building * step(controls.values[11] * 0.25, seg_f) * step(seg_f, 1.0 - controls.values[11] * 0.15);
    let lit = led * step(seg_id, energy * segs);
    // Blue (left) -> cyan -> magenta (right)
    let t = cell / max(count - 1.0, 1.0);
    let col_a = mix(vec3f(0.05, 0.25, 1.0), vec3f(0.0, 0.95, 1.0), smoothstep(0.0, 0.45, t));
    let col_b = mix(vec3f(0.0, 0.95, 1.0), vec3f(1.0, 0.05, 0.85), smoothstep(0.4, 1.0, t));
    let bar_col = mix(col_a, col_b, controls.values[7]);
    var color = bar_col * lit * (0.75 + energy * 0.55);
    // Soft glow around bars
    color += bar_col * building * glow(abs(uv.y - top), 0.01) * 0.45;
    color += bar_col * lit * lit * 0.35;
    // Mirror reflection
    if uv.y > horizon {
        let ry = horizon - (uv.y - horizon);
        let rh = (horizon - top);
        let rbuilding = in_bar * step(top, ry) * step(ry, horizon);
        let rseg = fract((horizon - ry) / max(h, 0.001) * segs);
        let rled = rbuilding * step(0.2, rseg) * step(rseg, 0.85) * step(floor((horizon - ry) / max(h, 0.001) * segs), energy * segs);
        let fade = exp(-(uv.y - horizon) * 6.0) * controls.values[5];
        color += bar_col * rled * fade * 0.55;
        color += bar_col * controls.values[8] * fade * 0.12 * energy;
    }
    // Starfield / particles
    let sp = hash21(floor(p.xy * 0.35) + floor(uniforms.time * 0.5));
    let stars = step(0.992 - controls.values[6] * 0.006, sp) * (0.4 + energy * 0.3);
    color += mix(vec3f(0.3, 0.7, 1.0), vec3f(1.0, 0.3, 0.9), t) * stars * controls.values[6];
    // Floor line
    color += bar_col * glow(abs(uv.y - horizon), 0.004) * 0.35 * controls.values[8];
    color = tonemap(color, controls.values[9]);
    return vec4f(color, 1.0);
}
