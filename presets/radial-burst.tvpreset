//! format: 2
//! id: thevisualizer.radial-burst
//! name: Radial Burst
//! version: 0.2.0
//! author: TheVisualizer
//! license: Apache-2.0
//! parameter: Audio|response|Response|0.4|5.0|1.95
//! parameter: Ring|radius|Core Radius|0.08|0.55|0.22
//! parameter: Ring|spokes|Spoke Count|32.0|180.0|96.0
//! parameter: Ring|length|Ray Length|0.2|2.0|1.05
//! parameter: Ring|segments|Ray Segments|4.0|24.0|12.0
//! parameter: Motion|rotation|Rotation|-2.0|2.0|0.12
//! parameter: Surface|core|Core Darkness|0.5|1.0|0.92
//! parameter: Color|magenta|Magenta Bias|0.0|1.0|0.65
//! parameter: Surface|bloom|Bloom|0.0|4.0|1.85
//! parameter: Surface|lightning|Lightning|0.0|2.0|0.75
//! parameter: Surface|exposure|Exposure|0.3|3.0|1.3
//! parameter: Ring|thickness|Spoke Thickness|0.3|3.0|1.2
//! ---
struct PresetUniforms { resolution: vec2f, time: f32, gain: f32, audio: vec4f }
@group(0) @binding(0) var<uniform> uniforms: PresetUniforms;
struct AudioFeatures { waveform: array<f32, 256>, spectrum: array<f32, 64> }
@group(0) @binding(1) var<storage, read> features: AudioFeatures;
struct FrameExtras { delta: f32, peak: f32, waveform_len: f32, spectrum_len: f32, onset: f32, transient: f32, history_rows: f32, history_bands: f32 }
@group(0) @binding(2) var<uniform> extras: FrameExtras;
struct SceneState { values: array<f32, 96> }
@group(0) @binding(3) var<storage, read> scene: SceneState;
struct ModeParameters { values: array<f32, 40> }
@group(0) @binding(4) var<storage, read> controls: ModeParameters;

@vertex fn vs_main(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
    let v = array(vec2f(-1.0, -3.0), vec2f(3.0, 1.0), vec2f(-1.0, 1.0));
    return vec4f(v[i], 0.0, 1.0);
}

fn hash21(p: vec2f) -> f32 { return fract(sin(dot(p, vec2f(127.1, 311.7))) * 43758.5453); }
fn glow(d: f32, w: f32) -> f32 { return exp(-d * d / max(w * w, 1e-6)); }
fn hsv(h: f32, s: f32, v: f32) -> vec3f {
    let k = vec3f(1.0, 2.0 / 3.0, 1.0 / 3.0);
    let p = abs(fract(vec3f(h) + k) * 6.0 - 3.0);
    return v * mix(vec3f(1.0), clamp(p - 1.0, vec3f(0.0), vec3f(1.0)), s);
}
fn tonemap(c: vec3f, e: f32) -> vec3f { return 1.0 - exp(-max(c, vec3f(0.0)) * e); }
fn band(i: u32) -> f32 {
    return clamp(features.spectrum[min(i, 63u)] * uniforms.gain * controls.values[0], 0.0, 1.8);
}
fn wave_at(x: f32) -> f32 {
    let i = min(u32(clamp(x, 0.0, 0.999) * 256.0), 255u);
    return features.waveform[i];
}

@fragment fn fs_main(@builtin(position) p: vec4f) -> @location(0) vec4f {
    let res = max(uniforms.resolution, vec2f(1.0));
    let uv = (p.xy * 2.0 - res) / res.y;
    let r = length(uv);
    let ang = atan2(uv.y, uv.x) + uniforms.time * controls.values[5];
    let spokes = controls.values[2];
    let spoke_id = floor((ang / 6.2831853 + 0.5) * spokes);
    let spoke_f = fract((ang / 6.2831853 + 0.5) * spokes);
    let src = min(u32(fract(spoke_id / spokes + 0.5) * 64.0), 63u);
    let energy = band(src) * (1.0 + extras.transient * 0.4);
    let core_r = controls.values[1] * (1.0 + uniforms.audio.x * 0.05);
    let ray_end = core_r + 0.04 + energy * controls.values[3] * 0.55;
    let thick = controls.values[11] * 0.012;
    let spoke_mask = exp(-pow(abs(spoke_f - 0.5) * 2.0 / thick, 2.0));
    let on_ray = step(core_r, r) * step(r, ray_end) * spoke_mask;
    // Segmented LEDs along each ray
    let segs = controls.values[4];
    let along = (r - core_r) / max(ray_end - core_r, 0.001);
    let seg = floor(along * segs);
    let seg_f = fract(along * segs);
    let led = on_ray * step(seg, energy * segs) * step(0.12, seg_f) * step(seg_f, 0.88);
    // Magenta top / blue bottom like reference
    let elev = clamp(uv.y * 0.5 + 0.5, 0.0, 1.0);
    let col = mix(
        mix(vec3f(0.1, 0.35, 1.0), vec3f(0.85, 0.1, 1.0), controls.values[7]),
        mix(vec3f(1.0, 0.05, 0.85), vec3f(1.0, 0.2, 0.95), controls.values[7]),
        elev
    );
    let ring = glow(abs(r - core_r), 0.008 + energy * 0.004) * (1.2 + energy);
    let core = smoothstep(core_r * 1.05, core_r * 0.2, r) * controls.values[6];
    // Lightning wisps
    let n = hash21(floor(uv * 18.0 + uniforms.time * 2.0));
    let bolt = step(0.97 - controls.values[9] * 0.02, n) * exp(-r * 1.5) * controls.values[9] * 0.35;
    var color = col * led * (0.7 + energy);
    color += col * ring * 1.1;
    color += col * led * led * controls.values[8] * 0.2;
    color += vec3f(0.7, 0.4, 1.0) * bolt;
    color *= 1.0 - core * 0.85;
    color += vec3f(0.4, 0.15, 0.6) * glow(r, core_r * 1.8) * 0.15 * energy;
    color = tonemap(color, controls.values[10]);
    return vec4f(color, 1.0);
}
