//! format: 1
//! id: thevisualizer.solar-bloom
//! name: Solar Bloom
//! version: 0.1.0
//! author: TheVisualizer
//! license: Apache-2.0
//! parameter: response|0.4|5.0|1.8
//! ---
struct PresetUniforms {
    resolution: vec2f,
    time: f32,
    gain: f32,
    audio: vec4f,
}

@group(0) @binding(0)
var<uniform> uniforms: PresetUniforms;

struct AudioFeatures {
    waveform: array<f32, 256>,
    spectrum: array<f32, 64>,
}

@group(0) @binding(1)
var<storage, read> features: AudioFeatures;

struct FrameExtras {
    delta: f32,
    peak: f32,
    waveform_len: f32,
    spectrum_len: f32,
}

@group(0) @binding(2)
var<uniform> extras: FrameExtras;

@vertex
fn vs_main(@builtin(vertex_index) vertex_index: u32) -> @builtin(position) vec4f {
    let positions = array(
        vec2f(-1.0, -3.0),
        vec2f(3.0, 1.0),
        vec2f(-1.0, 1.0),
    );
    return vec4f(positions[vertex_index], 0.0, 1.0);
}

fn palette(t: f32) -> vec3f {
    return 0.52 + 0.48 * cos(6.28318 * (t + vec3f(0.02, 0.31, 0.58)));
}

@fragment
fn fs_main(@builtin(position) position: vec4f) -> @location(0) vec4f {
    let resolution = max(uniforms.resolution, vec2f(1.0));
    var uv = (position.xy * 2.0 - resolution) / resolution.y;
    let low = clamp(uniforms.audio.x * uniforms.gain, 0.0, 1.5);
    let mid = clamp(uniforms.audio.y * uniforms.gain, 0.0, 1.5);
    let high = clamp(uniforms.audio.z * uniforms.gain, 0.0, 1.5);
    let rms = clamp(uniforms.audio.w * uniforms.gain * 3.0, 0.0, 1.5);

    uv += vec2f(sin(uniforms.time * 0.17), cos(uniforms.time * 0.13)) * 0.08;
    let radius = length(uv);
    let angle = atan2(uv.y, uv.x);
    let phase = fract(angle / 6.28318 + 1.0);
    let waveform_index = min(u32(phase * 256.0), 255u);
    let spectrum_index = min(u32(phase * 64.0), 63u);
    let wave = features.waveform[waveform_index] * uniforms.gain;
    let local_spectrum = clamp(features.spectrum[spectrum_index] * uniforms.gain, 0.0, 1.5);
    let petals = 7.0 + floor(high * 4.0);
    let edge = 0.42
        + sin(angle * petals + uniforms.time * 0.65) * (0.08 + mid * 0.09)
        + wave * 0.055;
    let bloom = abs(radius - edge * (1.0 + low * 0.2));
    let glow = 0.018 / max(bloom, 0.004);
    let halo = 0.008 / max(abs(radius - 0.78 - low * 0.08), 0.008);
    let rays = pow(abs(cos(angle * 9.0 - uniforms.time * 0.3)), 22.0)
        * smoothstep(1.2, 0.1, radius);

    var color = palette(angle / 6.28318 + uniforms.time * 0.025) * glow;
    color += palette(0.16 + uniforms.time * 0.018) * halo
        * (0.2 + low + local_spectrum * 0.4);
    color += vec3f(1.0, 0.32, 0.06) * rays * (0.04 + high * 0.25);
    color *= 0.3 + smoothstep(1.45, 0.12, radius);
    color = 1.0 - exp(-color * (0.8 + rms * 1.6 + extras.peak * 0.6));
    return vec4f(color, 1.0);
}
