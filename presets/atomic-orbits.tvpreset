//! format: 2
//! id: thevisualizer.atomic-orbits
//! name: Atomic Orbits
//! version: 0.2.0
//! author: TheVisualizer
//! license: Apache-2.0
//! parameter: Audio|response|Response|0.4|5.0|1.9
//! parameter: Atom|orbits|Orbit Count|4.0|16.0|9.0
//! parameter: Atom|size|Orbit Size|0.2|0.9|0.52
//! parameter: Atom|eccentricity|Eccentricity|1.2|4.0|2.4
//! parameter: Motion|spin|Electron Spin|-3.0|3.0|0.95
//! parameter: Motion|precession|Precession|-2.0|2.0|0.35
//! parameter: Atom|trails|Trail Layers|2.0|12.0|7.0
//! parameter: Atom|electrons|Electron Size|0.0|3.0|1.25
//! parameter: Surface|core|Nucleus|0.0|3.0|1.5
//! parameter: Color|blue|Blue Intensity|0.5|1.5|1.1
//! parameter: Surface|bloom|Bloom|0.0|4.0|1.65
//! parameter: Surface|exposure|Exposure|0.3|3.0|1.25
//! ---
struct PresetUniforms { resolution: vec2f, time: f32, gain: f32, audio: vec4f }
@group(0) @binding(0) var<uniform> uniforms: PresetUniforms;
struct AudioFeatures { waveform: array<f32, 256>, spectrum: array<f32, 64> }
@group(0) @binding(1) var<storage, read> features: AudioFeatures;
struct FrameExtras { delta: f32, peak: f32, waveform_len: f32, spectrum_len: f32, onset: f32, transient: f32, history_rows: f32, history_bands: f32 }
@group(0) @binding(2) var<uniform> extras: FrameExtras;
struct SceneState { values: array<f32, 96> }
@group(0) @binding(3) var<storage, read> scene: SceneState;
struct ModeParameters { values: array<f32, 40> }
@group(0) @binding(4) var<storage, read> controls: ModeParameters;

@vertex fn vs_main(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
    let v = array(vec2f(-1.0, -3.0), vec2f(3.0, 1.0), vec2f(-1.0, 1.0));
    return vec4f(v[i], 0.0, 1.0);
}

fn hash21(p: vec2f) -> f32 { return fract(sin(dot(p, vec2f(127.1, 311.7))) * 43758.5453); }
fn glow(d: f32, w: f32) -> f32 { return exp(-d * d / max(w * w, 1e-6)); }
fn hsv(h: f32, s: f32, v: f32) -> vec3f {
    let k = vec3f(1.0, 2.0 / 3.0, 1.0 / 3.0);
    let p = abs(fract(vec3f(h) + k) * 6.0 - 3.0);
    return v * mix(vec3f(1.0), clamp(p - 1.0, vec3f(0.0), vec3f(1.0)), s);
}
fn tonemap(c: vec3f, e: f32) -> vec3f { return 1.0 - exp(-max(c, vec3f(0.0)) * e); }
fn band(i: u32) -> f32 {
    return clamp(features.spectrum[min(i, 63u)] * uniforms.gain * controls.values[0], 0.0, 1.8);
}
fn wave_at(x: f32) -> f32 {
    let i = min(u32(clamp(x, 0.0, 0.999) * 256.0), 255u);
    return features.waveform[i];
}

fn rotate(p: vec2f, a: f32) -> vec2f {
    let c = cos(a); let s = sin(a);
    return vec2f(c * p.x - s * p.y, s * p.x + c * p.y);
}
@fragment fn fs_main(@builtin(position) p: vec4f) -> @location(0) vec4f {
    let res = max(uniforms.resolution, vec2f(1.0));
    let uv = (p.xy * 2.0 - res) / res.y;
    let count = u32(controls.values[1]);
    let trails = u32(controls.values[6]);
    let size = controls.values[2] * (1.0 + uniforms.audio.x * 0.06 + extras.onset * 0.04);
    var color = vec3f(0.0);
    for (var o = 0u; o < 16u; o += 1u) {
        if o < count {
            let fo = f32(o);
            let pre = fo * 0.7 + uniforms.time * controls.values[5] * 0.25;
            let src = min(u32(fo / max(f32(count), 1.0) * 64.0), 63u);
            let e = band(src);
            for (var tr = 0u; tr < 12u; tr += 1u) {
                if tr < trails {
                    let ft = f32(tr);
                    let spin = uniforms.time * controls.values[4] * (0.7 + fo * 0.08) - ft * 0.08;
                    let q = rotate(uv, pre + ft * 0.04);
                    let ecc = controls.values[3];
                    let d = abs(length(vec2f(q.x, q.y * ecc)) - size * (0.75 + fo * 0.03 + e * 0.04));
                    let fade = mix(1.0, 0.15, ft / max(f32(trails), 1.0));
                    let line = glow(d, 0.0045 + ft * 0.0004) * fade;
                    // Electron beads
                    let ea = spin + fo * 1.7;
                    let ep = vec2f(cos(ea), sin(ea) / ecc) * size * (0.75 + fo * 0.03);
                    let electron = glow(length(q - ep), 0.012 * controls.values[7] * (0.7 + e)) * fade;
                    let col = vec3f(0.25, 0.7, 1.0) * controls.values[9];
                    let col2 = vec3f(0.7, 0.9, 1.0);
                    color += mix(col, col2, ft * 0.08) * line * (0.45 + e * 0.5);
                    color += col2 * electron * controls.values[7];
                }
            }
        }
    }
    let nucleus = glow(length(uv), 0.04 + uniforms.audio.x * 0.03) * controls.values[8];
    color += vec3f(0.85, 0.95, 1.0) * nucleus * (1.0 + extras.transient * 1.2);
    color += color * color * controls.values[10] * 0.1;
    color = tonemap(color, controls.values[11]);
    return vec4f(color, 1.0);
}
