//! format: 2
//! id: thevisualizer.wave-tunnel
//! name: Wave Tunnel
//! version: 0.2.0
//! author: TheVisualizer
//! license: Apache-2.0
//! parameter: Audio|response|Response|0.4|5.0|2.0
//! parameter: Tunnel|rings|Ring Count|8.0|48.0|22.0
//! parameter: Tunnel|warp|Wave Warp|0.0|3.0|1.45
//! parameter: Tunnel|speed|Flight Speed|0.0|4.0|1.25
//! parameter: Tunnel|aperture|Aperture|0.02|0.35|0.08
//! parameter: Tunnel|rays|Radial Rays|0.0|2.0|0.95
//! parameter: Surface|thickness|Line Thickness|0.3|3.0|1.2
//! parameter: Color|ember|Ember Heat|0.0|1.0|0.75
//! parameter: Surface|bloom|Bloom|0.0|4.0|1.75
//! parameter: Surface|particles|Dust|0.0|2.0|0.8
//! parameter: Surface|exposure|Exposure|0.3|3.0|1.3
//! parameter: Motion|roll|Roll|-2.0|2.0|0.15
//! ---
struct PresetUniforms { resolution: vec2f, time: f32, gain: f32, audio: vec4f }
@group(0) @binding(0) var<uniform> uniforms: PresetUniforms;
struct AudioFeatures { waveform: array<f32, 256>, spectrum: array<f32, 64> }
@group(0) @binding(1) var<storage, read> features: AudioFeatures;
struct FrameExtras { delta: f32, peak: f32, waveform_len: f32, spectrum_len: f32, onset: f32, transient: f32, history_rows: f32, history_bands: f32 }
@group(0) @binding(2) var<uniform> extras: FrameExtras;
struct SceneState { values: array<f32, 96> }
@group(0) @binding(3) var<storage, read> scene: SceneState;
struct ModeParameters { values: array<f32, 40> }
@group(0) @binding(4) var<storage, read> controls: ModeParameters;

@vertex fn vs_main(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
    let v = array(vec2f(-1.0, -3.0), vec2f(3.0, 1.0), vec2f(-1.0, 1.0));
    return vec4f(v[i], 0.0, 1.0);
}

fn hash21(p: vec2f) -> f32 { return fract(sin(dot(p, vec2f(127.1, 311.7))) * 43758.5453); }
fn glow(d: f32, w: f32) -> f32 { return exp(-d * d / max(w * w, 1e-6)); }
fn hsv(h: f32, s: f32, v: f32) -> vec3f {
    let k = vec3f(1.0, 2.0 / 3.0, 1.0 / 3.0);
    let p = abs(fract(vec3f(h) + k) * 6.0 - 3.0);
    return v * mix(vec3f(1.0), clamp(p - 1.0, vec3f(0.0), vec3f(1.0)), s);
}
fn tonemap(c: vec3f, e: f32) -> vec3f { return 1.0 - exp(-max(c, vec3f(0.0)) * e); }
fn band(i: u32) -> f32 {
    return clamp(features.spectrum[min(i, 63u)] * uniforms.gain * controls.values[0], 0.0, 1.8);
}
fn wave_at(x: f32) -> f32 {
    let i = min(u32(clamp(x, 0.0, 0.999) * 256.0), 255u);
    return features.waveform[i];
}

@fragment fn fs_main(@builtin(position) p: vec4f) -> @location(0) vec4f {
    let res = max(uniforms.resolution, vec2f(1.0));
    var uv = (p.xy * 2.0 - res) / res.y;
    let roll = uniforms.time * controls.values[11] * 0.2;
    let c = cos(roll); let s = sin(roll);
    uv = vec2f(c * uv.x - s * uv.y, s * uv.x + c * uv.y);
    let r = length(uv) + 1e-4;
    let ang = atan2(uv.y, uv.x);
    // Waveform warps radius
    let w = wave_at(fract(ang / 6.2831853 + 0.5)) * controls.values[0];
    let warp = w * controls.values[2] * 0.12;
    let flight = uniforms.time * controls.values[3] * 0.55;
    let log_r = log(r + controls.values[4]);
    var color = vec3f(0.0);
    let rings = u32(controls.values[1]);
    for (var i = 0u; i < 48u; i += 1u) {
        if i < rings {
            let f = f32(i);
            let z = fract(f / f32(rings) - flight * 0.08);
            let ring_r = mix(controls.values[4], 1.6, z);
            let wobble = sin(ang * 6.0 + flight * 3.0 + f) * warp * (0.4 + z);
            let d = abs(r - (ring_r + wobble));
            let thick = controls.values[6] * 0.004 * (1.0 + z * 2.0);
            let line = glow(d, thick);
            // Sample spectrum around the ring
            let src = min(u32(fract(ang / 6.2831853 + 0.5) * 64.0), 63u);
            let e = band(src);
            let heat = mix(vec3f(1.0, 0.12, 0.0), vec3f(1.0, 0.85, 0.15), controls.values[7] * (1.0 - z) + e * 0.25);
            color += heat * line * (0.55 + e * 0.7) * (1.0 - z * 0.5);
        }
    }
    // Radial rays to vanishing point
    let rays = pow(max(0.0, cos(ang * 24.0 + flight)), 12.0) * controls.values[5];
    color += vec3f(1.0, 0.25, 0.05) * rays * exp(-r * 0.8) * 0.25;
    // Side waveform ribbons
    let side = glow(abs(uv.y - wave_at(clamp(uv.x * 0.5 + 0.5, 0.0, 0.999)) * controls.values[2] * 0.25), 0.01);
    color += vec3f(1.0, 0.45, 0.05) * side * 0.35 * step(0.35, abs(uv.x));
    // Dust particles
    let dust = step(0.994 - controls.values[9] * 0.004, hash21(floor(uv * 40.0 + flight * 2.0)));
    color += vec3f(1.0, 0.5, 0.1) * dust * controls.values[9] * 0.5;
    // Center core
    color += vec3f(1.0, 0.9, 0.4) * glow(r, 0.04) * (1.0 + extras.onset);
    color += color * color * controls.values[8] * 0.12;
    color = tonemap(color, controls.values[10]);
    return vec4f(color, 1.0);
}
