//! format: 2
//! id: thevisualizer.ripple-garden
//! name: Ripple Garden
//! version: 0.1.0
//! author: TheVisualizer
//! license: Apache-2.0
//! parameter: Audio|response|Response|0.4|5.0|1.7
//! parameter: Audio|bass-ripples|Bass Ripples|0.0|3.0|1.3
//! parameter: Audio|treble-drops|Treble Drops|0.0|3.0|1.1
//! parameter: Water|ripple-scale|Ripple Scale|4.0|30.0|13.0
//! parameter: Water|wave-speed|Wave Speed|-4.0|4.0|1.4
//! parameter: Water|damping|Damping|0.2|5.0|1.8
//! parameter: Garden|petal-count|Petal Count|3.0|16.0|8.0
//! parameter: Garden|bloom-size|Bloom Size|0.05|0.8|0.32
//! parameter: Garden|stem-motion|Stem Motion|0.0|2.0|0.65
//! parameter: Light|caustic-glow|Caustic Glow|0.0|3.0|1.2
//! parameter: Camera|drift|Camera Drift|-2.0|2.0|0.08
//! parameter: Scene|seed|Seed|0.0|999.0|83.0
//! ---
struct PresetUniforms { resolution: vec2f, time: f32, gain: f32, audio: vec4f }
@group(0) @binding(0) var<uniform> uniforms: PresetUniforms;
struct AudioFeatures { waveform: array<f32, 256>, spectrum: array<f32, 64> }
@group(0) @binding(1) var<storage, read> features: AudioFeatures;
struct FrameExtras { delta: f32, peak: f32, waveform_len: f32, spectrum_len: f32 }
@group(0) @binding(2) var<uniform> extras: FrameExtras;
struct SceneState { values: array<f32, 96> }
@group(0) @binding(3) var<storage, read> scene: SceneState;
struct ModeParameters { values: array<f32, 40> }
@group(0) @binding(4) var<storage, read> controls: ModeParameters;

@vertex
fn vs_main(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {
    let vertices = array(vec2f(-1.0, -3.0), vec2f(3.0, 1.0), vec2f(-1.0, 1.0));
    return vec4f(vertices[index], 0.0, 1.0);
}

fn hash21(p: vec2f) -> f32 {
    return fract(sin(dot(p, vec2f(127.1, 311.7))) * 43758.5453);
}

fn routed(offset: u32) -> vec3f {
    return vec3f(scene.values[offset], scene.values[offset + 1u], scene.values[offset + 2u]);
}

@fragment
fn fs_main(@builtin(position) position: vec4f) -> @location(0) vec4f {
    let resolution = max(uniforms.resolution, vec2f(1.0));
    let aspect = resolution.x / resolution.y;
    var uv = (position.xy * 2.0 - resolution) / resolution.y;
    uv.x += sin(uniforms.time * controls.values[10]) * 0.08;
    uv /= max(scene.values[4], 0.35);
    let response = controls.values[0];
    let bass = clamp(uniforms.audio.x * response, 0.0, 1.5);
    let high = clamp(uniforms.audio.z * response, 0.0, 1.5);
    var height = 0.0;
    var zone_light = vec3f(0.0);

    for (var index = 0u; index < 8u; index += 1u) {
        if f32(index) < scene.values[0] {
            let offset = 8u + index * 8u;
            let center = vec2f(
                (scene.values[offset] * 2.0 - 1.0) * aspect,
                scene.values[offset + 1u] * 2.0 - 1.0
            );
            let distance = length(uv - center);
            let energy = scene.values[offset + 3u] * scene.values[offset + 6u];
            let ripple = sin(distance * controls.values[3] - uniforms.time * controls.values[4]
                - energy * 4.0) * exp(-distance * controls.values[5]);
            height += ripple * (0.12 + energy * controls.values[1]);
            let band = u32(clamp(scene.values[offset + 4u], 0.0, 3.0));
            let color_offset = select(72u, 72u + band * 4u, band > 0u);
            zone_light += routed(color_offset) * exp(-distance * distance * 8.0)
                * (0.1 + energy);
        }
    }

    let cell = floor((uv + controls.values[11]) * 5.0);
    let local = fract((uv + controls.values[11]) * 5.0) - 0.5;
    let seed = hash21(cell);
    let petals = floor(controls.values[6] + 0.5);
    let polar = atan2(local.y, local.x);
    let flower_radius = length(local);
    let petal_edge = controls.values[7] * (0.48 + 0.22 * sin(polar * petals
        + uniforms.time * controls.values[8] + seed * 6.28318));
    let flower = 1.0 - smoothstep(petal_edge, petal_edge + 0.04, flower_radius);
    let drop_cell = floor((uv + vec2f(0.0, uniforms.time * 0.08)) * 34.0);
    let drops = step(0.994 - high * controls.values[2] * 0.004, hash21(drop_cell));
    let caustics = pow(abs(sin((uv.x + height) * 18.0) * cos((uv.y - height) * 16.0)), 12.0);

    var color = routed(88u) * (0.7 + height * 0.15);
    color += mix(routed(80u), routed(84u), seed) * flower * (0.08 + bass * 0.22);
    color += zone_light * 0.4;
    color += routed(72u) * caustics * controls.values[9] * (0.15 + abs(height));
    color += routed(84u) * drops * (0.2 + high);
    color = 1.0 - exp(-max(color, vec3f(0.0)) * (0.9 + scene.values[92]));
    return vec4f(color, 1.0);
}
