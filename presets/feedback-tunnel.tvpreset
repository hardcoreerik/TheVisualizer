//! format: 2
//! id: thevisualizer.feedback-tunnel
//! name: Feedback Tunnel
//! version: 0.1.0
//! author: TheVisualizer
//! license: Apache-2.0
//! parameter: Audio|response|Response|0.5|6.0|2.2
//! parameter: Motion|drift-speed|Drift Speed|0.0|3.0|1.0
//! parameter: Motion|drift-amount|Drift Amount|0.0|0.5|0.12
//! parameter: Tunnel|ring-density|Ring Density|0.2|3.0|1.0
//! parameter: Tunnel|twist|Twist|0.0|3.0|1.0
//! parameter: Tunnel|spoke-count|Spoke Count|2.0|16.0|5.0
//! parameter: Tunnel|spoke-sharpness|Spoke Sharpness|2.0|48.0|28.0
//! parameter: Motion|travel-speed|Travel Speed|-4.0|4.0|1.0
//! parameter: Surface|core-glow|Core Glow|0.0|3.0|1.0
//! parameter: Surface|vignette|Vignette|0.0|2.0|1.0
//! parameter: Physics|zone-warp|Zone Warp|0.0|2.0|0.55
//! parameter: Scene|seed|Seed|0.0|999.0|11.0
//! ---
struct TunnelUniforms {
    resolution: vec2f,
    time: f32,
    gain: f32,
    audio: vec4f,
}

@group(0) @binding(0)
var<uniform> uniforms: TunnelUniforms;

struct AudioFeatures {
    waveform: array<f32, 256>,
    spectrum: array<f32, 64>,
}

@group(0) @binding(1)
var<storage, read> features: AudioFeatures;

struct FrameExtras {
    delta: f32,
    peak: f32,
    waveform_len: f32,
    spectrum_len: f32,
    onset: f32,
    transient: f32,
}

@group(0) @binding(2)
var<uniform> extras: FrameExtras;

struct SceneState { values: array<f32, 96> }
@group(0) @binding(3) var<storage, read> scene: SceneState;
struct ModeParameters { values: array<f32, 40> }
@group(0) @binding(4) var<storage, read> controls: ModeParameters;

@vertex
fn vs_main(@builtin(vertex_index) vertex_index: u32) -> @builtin(position) vec4f {
    let positions = array(
        vec2f(-1.0, -3.0),
        vec2f(3.0, 1.0),
        vec2f(-1.0, 1.0),
    );
    return vec4f(positions[vertex_index], 0.0, 1.0);
}

fn palette(value: f32) -> vec3f {
    let base = vec3f(0.05, 0.35, 0.55);
    let amplitude = vec3f(0.45, 0.55, 0.50);
    let phase = vec3f(0.10, 0.36, 0.72);
    return base + amplitude * cos(6.28318 * (value + phase));
}

fn saturate_color(color: vec3f, amount: f32) -> vec3f {
    let luminance = dot(color, vec3f(0.2126, 0.7152, 0.0722));
    return mix(vec3f(luminance), color, amount);
}

@fragment
fn fs_main(@builtin(position) position: vec4f) -> @location(0) vec4f {
    let safe_resolution = max(uniforms.resolution, vec2f(1.0));
    var uv = (position.xy * 2.0 - safe_resolution) / safe_resolution.y;

    let gain = controls.values[0];
    let low = clamp(uniforms.audio.x * gain, 0.0, 1.5);
    let mid = clamp(uniforms.audio.y * gain, 0.0, 1.5);
    let high = clamp(uniforms.audio.z * gain, 0.0, 1.5);
    let rms = clamp(uniforms.audio.w * gain * 3.0, 0.0, 1.5);

    let drift = vec2f(
        sin(uniforms.time * 0.31 * controls.values[1] + controls.values[11]),
        cos(uniforms.time * 0.23 * controls.values[1])
    ) * controls.values[2] * (0.5 + mid * 0.4);
    uv += drift;
    for (var index = 0u; index < 8u; index += 1u) {
        if f32(index) < scene.values[0] {
            let offset = 8u + index * 8u;
            let center = vec2f(
                (scene.values[offset] * 2.0 - 1.0) * safe_resolution.x / safe_resolution.y,
                scene.values[offset + 1u] * 2.0 - 1.0
            );
            let delta = uv - center;
            let energy = scene.values[offset + 3u] * scene.values[offset + 6u];
            uv += normalize(delta + vec2f(0.001)) * exp(-length(delta) * 4.0)
                * energy * controls.values[10] * 0.08;
        }
    }

    let radius = max(length(uv), 0.015);
    let angle = atan2(uv.y, uv.x);
    let spectrum_index = min(u32(fract(angle / 6.28318 + 1.0) * 64.0), 63u);
    let local_spectrum = clamp(features.spectrum[spectrum_index] * gain, 0.0, 1.5);
    let impact = extras.onset * 0.18 + extras.transient * 0.04;
    let depth = (1.0 + impact) / (radius + 0.08);
    let twist = sin(angle * (7.0 + high * 3.0) * controls.values[4]
        + depth * 0.8 - uniforms.time);
    let travel = depth * (0.42 + low * 0.12) * controls.values[3]
        - uniforms.time * controls.values[7] * (0.7 + low * 1.3);
    let rings = abs(fract(travel + twist * 0.055) - 0.5);
    let ring_glow = (0.016 + local_spectrum * 0.008) / max(rings, 0.004);

    let spokes = pow(
        abs(cos(angle * (controls.values[5] + floor(high * 2.0)) + uniforms.time * 0.24)),
        controls.values[6]
    );
    let core = exp(-radius * (1.8 - min(rms, 0.9)));
    let pulse = 0.72 + 0.28 * sin(
        uniforms.time * 2.1 + depth * 0.45 + low * 4.0 + extras.peak * 2.0
    );

    var color = palette(travel * 0.075 + angle * 0.035 + uniforms.time * 0.045);
    color *= ring_glow * pulse * (0.18 + core * 0.95 * controls.values[8])
        * (1.0 + impact * 1.5);
    color += palette(0.62 + uniforms.time * 0.02) * spokes
        * (0.05 + high * 0.18 + local_spectrum * 0.14);
    color += vec3f(0.005, 0.009, 0.022);

    let vignette = smoothstep(1.65, 0.18 * controls.values[9], radius);
    color *= 0.32 + vignette * 0.92;
    let glow = scene.values[92];
    let gloss = scene.values[93];
    let finish = scene.values[95];
    if finish < 0.5 {
        color *= 0.85 + glow * 0.35;
    } else if finish < 1.5 {
        color += pow(max(color, vec3f(0.0)), vec3f(4.0)) * gloss;
    } else if finish < 2.5 {
        color *= 0.72;
    } else if finish < 3.5 {
        color = mix(color, vec3f(dot(color, vec3f(0.3, 0.55, 0.15))), 0.22 + gloss * 0.25);
    } else {
        color = mix(color, color * color + palette(0.62) * 0.04, 0.35 + gloss * 0.35);
    }
    color = saturate_color(color, scene.values[94]);
    color = 1.0 - exp(-color * (1.0 + rms * 1.8));

    return vec4f(color, 1.0);
}
