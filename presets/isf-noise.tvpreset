//! format: 2
//! id: isf.vidvox.noise
//! name: ISF · Signal Noise
//! version: 0.1.0
//! author: VIDVOX; TheVisualizer WGSL and audio adaptation
//! license: MIT
//! parameter: Audio|response|Response|0.4|5.0|1.8
//! parameter: Noise|seed|Seed|0.01|100.0|7.0
//! parameter: Noise|cell-size|Cell Size|1.0|180.0|72.0
//! parameter: Noise|threshold|Threshold|0.0|1.0|0.18
//! parameter: Noise|speed|Speed|0.0|8.0|1.1
//! parameter: Noise|color-mode|Color Mode|0.0|3.0|2.0
//! parameter: Audio|bass-scale|Bass Scale|0.0|3.0|1.0
//! parameter: Audio|mid-color|Mid Color|0.0|3.0|1.1
//! parameter: Audio|treble-static|Treble Static|0.0|3.0|1.3
//! parameter: Signal|scanlines|Scanlines|0.0|2.0|0.45
//! parameter: Signal|persistence|Persistence|0.0|1.0|0.35
//! parameter: Signal|exposure|Exposure|0.2|3.0|0.9
//! ---
struct PresetUniforms { resolution: vec2f, time: f32, gain: f32, audio: vec4f }
@group(0) @binding(0) var<uniform> uniforms: PresetUniforms;
struct AudioFeatures { waveform: array<f32, 256>, spectrum: array<f32, 64> }
@group(0) @binding(1) var<storage, read> features: AudioFeatures;
struct FrameExtras { delta: f32, peak: f32, waveform_len: f32, spectrum_len: f32, onset: f32, transient: f32 }
@group(0) @binding(2) var<uniform> extras: FrameExtras;
struct SceneState { values: array<f32, 96> }
@group(0) @binding(3) var<storage, read> scene: SceneState;
struct ModeParameters { values: array<f32, 40> }
@group(0) @binding(4) var<storage, read> controls: ModeParameters;
@vertex fn vs_main(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
    let v = array(vec2f(-1.0, -3.0), vec2f(3.0, 1.0), vec2f(-1.0, 1.0));
    return vec4f(v[i], 0.0, 1.0);
}
fn hash21(p: vec2f) -> f32 {
    var q = fract(p * vec2f(123.34, 345.45));
    q += dot(q, q + 34.345);
    return fract(q.x * q.y);
}
fn hsv(h: f32, s: f32, v: f32) -> vec3f {
    let k = fract(vec3f(h) + vec3f(0.0, 0.666667, 0.333333)) * 6.0;
    return v * mix(vec3f(1.0), clamp(abs(k - 3.0) - 1.0, vec3f(0.0), vec3f(1.0)), s);
}
@fragment fn fs_main(@builtin(position) p: vec4f) -> @location(0) vec4f {
    let res = max(uniforms.resolution, vec2f(1.0));
    let response = controls.values[0];
    let bass = clamp(uniforms.audio.x * response, 0.0, 1.5);
    let mid = clamp(uniforms.audio.y * response, 0.0, 1.5);
    let high = clamp(uniforms.audio.z * response, 0.0, 1.5);
    let scale = controls.values[2] * (1.0 + bass * controls.values[6] * 0.25);
    let tick = floor(uniforms.time * controls.values[4] * (1.0 + high * controls.values[8]));
    let cell = floor(p.xy / max(res.y / scale, 1.0));
    let value = hash21(cell + vec2f(controls.values[1], tick));
    let old_value = hash21(cell + vec2f(controls.values[1], tick - 1.0));
    let mixed = mix(value, old_value, controls.values[10]);
    let visible = step(controls.values[3], mixed);
    let mode = floor(controls.values[5] + 0.5);
    var color = vec3f(mixed);
    if (mode > 0.5) { color = hsv(fract(mixed + mid * controls.values[7] * 0.18), 0.78, mixed); }
    if (mode > 1.5) {
        color = vec3f(hash21(cell + 11.7 + tick), hash21(cell + 29.3 - tick), hash21(cell + 51.9 + tick));
    }
    if (mode > 2.5) { color *= 0.4 + 0.6 * hash21(cell + 83.1); }
    color *= visible * (0.86 + sin(p.y * 3.14159) * controls.values[9] * 0.1);
    color += vec3f(0.35, 0.65, 1.0) * extras.onset * high * 0.08;
    color = 1.0 - exp(-color * controls.values[11]);
    return vec4f(color, 1.0);
}
