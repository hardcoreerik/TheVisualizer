//! format: 2
//! id: thevisualizer.liquid-chrome
//! name: Liquid Chrome
//! version: 0.1.0
//! author: TheVisualizer
//! license: Apache-2.0
//! parameter: Audio|response|Response|0.4|5.0|1.7
//! parameter: Audio|bass-volume|Bass Volume|0.0|3.0|1.4
//! parameter: Audio|treble-glint|Treble Glint|0.0|3.0|1.3
//! parameter: Fluid|blob-count|Blob Count|2.0|10.0|5.0
//! parameter: Fluid|surface-tension|Surface Tension|0.2|4.0|1.4
//! parameter: Fluid|flow-speed|Flow Speed|-3.0|3.0|0.45
//! parameter: Chrome|reflection-bands|Reflection Bands|2.0|24.0|10.0
//! parameter: Chrome|fresnel|Fresnel|0.0|4.0|1.5
//! parameter: Chrome|glint|Glint|0.0|4.0|1.4
//! parameter: Motion|orbit|Orbit|-3.0|3.0|0.35
//! parameter: Camera|zoom|Zoom|0.3|2.5|1.0
//! parameter: Surface|exposure|Exposure|0.2|3.0|0.9
//! ---
struct PresetUniforms { resolution: vec2f, time: f32, gain: f32, audio: vec4f }
@group(0) @binding(0) var<uniform> uniforms: PresetUniforms;
struct AudioFeatures { waveform: array<f32, 256>, spectrum: array<f32, 64> }
@group(0) @binding(1) var<storage, read> features: AudioFeatures;
struct FrameExtras { delta: f32, peak: f32, waveform_len: f32, spectrum_len: f32, onset: f32, transient: f32 }
@group(0) @binding(2) var<uniform> extras: FrameExtras;
struct SceneState { values: array<f32, 96> }
@group(0) @binding(3) var<storage, read> scene: SceneState;
struct ModeParameters { values: array<f32, 40> }
@group(0) @binding(4) var<storage, read> controls: ModeParameters;

@vertex fn vs_main(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
    let v = array(vec2f(-1.0, -3.0), vec2f(3.0, 1.0), vec2f(-1.0, 1.0));
    return vec4f(v[i], 0.0, 1.0);
}
fn routed(o: u32) -> vec3f { return vec3f(scene.values[o], scene.values[o + 1u], scene.values[o + 2u]); }
fn field(q: vec2f, count: i32, bass: f32) -> f32 {
    var f = 0.0;
    for (var i = 0; i < 10; i += 1) {
        if i < count {
            let fi = f32(i);
            let center = vec2f(sin(fi * 2.17 + uniforms.time * controls.values[5]),
                               cos(fi * 1.63 - uniforms.time * controls.values[9])) * (0.28 + fi * 0.035);
            let radius = 0.08 + bass * controls.values[1] * 0.025 + 0.025 * sin(fi * 3.1);
            f += radius / max(length(q - center), 0.025);
        }
    }
    return f;
}
@fragment fn fs_main(@builtin(position) p: vec4f) -> @location(0) vec4f {
    let res = max(uniforms.resolution, vec2f(1.0));
    var uv = (p.xy * 2.0 - res) / res.y;
    uv /= max(scene.values[4] * controls.values[10], 0.25);
    let response = controls.values[0];
    let bass = clamp(uniforms.audio.x * response, 0.0, 1.5);
    let high = clamp(uniforms.audio.z * response, 0.0, 1.5);
    let count = i32(floor(controls.values[3] + 0.5));
    let f = field(uv, count, bass);
    let e = 0.004;
    let normal = normalize(vec2f(field(uv + vec2f(e, 0.0), count, bass) - field(uv - vec2f(e, 0.0), count, bass),
                                  field(uv + vec2f(0.0, e), count, bass) - field(uv - vec2f(0.0, e), count, bass)) + vec2f(0.0001));
    let surface = smoothstep(controls.values[4] - 0.12, controls.values[4] + 0.12, f);
    let bands = 0.5 + 0.5 * sin((normal.x + normal.y) * controls.values[6] + uniforms.time);
    let fresnel = pow(1.0 - clamp(abs(normal.y), 0.0, 1.0), controls.values[7]);
    let glint = pow(max(0.0, dot(normal, normalize(vec2f(-0.4, 0.9)))), 24.0)
        * controls.values[8] * (0.2 + high * controls.values[2] + extras.onset);
    let band_index = min(u32(clamp(bands, 0.0, 0.999) * 64.0), 63u);
    let spectrum = features.spectrum[band_index] * response;
    var chrome = mix(routed(76u), routed(80u), bands) * (0.16 + spectrum * 0.65);
    chrome += routed(84u) * fresnel * 0.7 + vec3f(1.0) * glint;
    var color = routed(88u) * (0.35 + 0.1 * sin(length(uv) * 5.0));
    color = mix(color, chrome, surface);
    color += routed(72u) * smoothstep(0.08, 0.0, abs(f - controls.values[4])) * bass * 0.3;
    color = 1.0 - exp(-max(color, vec3f(0.0)) * controls.values[11] * (0.8 + scene.values[92]));
    return vec4f(color, 1.0);
}
